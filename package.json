{
    "name": "hilo-service",
    "version": "1.0.0",
    "description": "",
    "main": "./src/app.js",
    "author": "pentagon",
    "license": "ISC",
    "type": "module",
    "scripts": {
        "start": "node --es-module-specifier-resolution=node .",
        "dev": "nodemon --es-module-specifier-resolution=node --watch ./src ./src/app.js",
        "debug": "nodemon --es-module-specifier-resolution=node --watch ./ --inspect ./src/app.js",
        "prod": "node --max-old-space-size=8192 --es-module-specifier-resolution=node ./src/app.js",
        "reg": "npm set registry https://npm.lumigame.com",
        "test": "jest --testPathPattern=__tests__",
        "test-coverage": "jest --collect-coverage --testPathPattern=__tests__",
        "integration-test": "jest --config ./jest.integration-test.config.cjs --testPathPattern=tests/integration-tests/ --ci --forceExit --runInBand",
        "stats": "node --es-module-specifier-resolution=node ./tests/statistics/low-risk-strategy.js"
    },
    "jestSonar": {
        "reportPath": "reports",
        "reportFile": "test-reporter.xml",
        "indent": 4
    },
    "dependencies": {
        "chance": "^1.1.7",
        "d3-array": "^3.2.0",
        "random": "^3.0.6",
        "random-js": "^2.1.0",
        "jest-date-mock": "^1.0.8",
        "lodash": "^4.17.19",
        "nodemon": "^2.0.4",
        "sc-game-base": "3.3.0"
    },
    "resolutions": {
        "sc-game-base": "3.3.0",
        "sc-base-apis": "1.18.2",
        "sc-base-database": "1.11.1"
    },
    "devDependencies": {
        "@babel/core": "7.24.5",
        "@babel/preset-env": "^7.12.11",
        "@commitlint/cli": "^9.1.2",
        "@commitlint/config-conventional": "^20.0.0",
        "@types/jest": "26.0.24",
        "babel-jest": "27.5.1",
        "husky": "^4.2.5",
        "install": "^0.13.0",
        "jest": "^26.6.3",
        "jest-extended": "^0.11.5",
        "jest-junit": "^12.2.0",
        "jest-micro-auto-stub": "^1.0.9",
        "jest-sonar-reporter": "^2.0.0",
        "sc-game-service-integration-utils": "1.3.3"
    },
    "husky": {
        "hooks": {
            "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
        }
    }
}
